PORT=4000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lulo_db
DB_USER=lulo_user
DB_PASSWORD=lulo_pass
DATABASE_URL=postgresql://lulo_user:lulo_pass@localhost:5432/lulo_db

# JWT
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Seeders path (relative to backend root)
SEEDERS_PATH=../my-app/seeders
